{
    "name": "voku/slop-scan",
    "description": "Deterministic PHP CLI for explainable slop heuristics in PHP repositories.",
    "type": "project",
    "require": {
        "php": "^8.3",
        "nikic/php-parser": "^5.8",
        "symfony/console": "^7.4",
        "voku/simple-php-code-parser": "^0.22.2",
        "helgesverre/toon": "^3.2"
    },
    "require-dev": {
        "infection/infection": "^0.34.2",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^13.0",
        "voku/agent-loop": "^0.16.3"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Lars Moelleken",
            "email": "lars@moelleken.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "SlopScan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SlopScan\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/slop-scan.php"
    ],
    "scripts": {
        "format:check": "find src tests bin build -name '*.php' -print0 | xargs -0 -n1 php -l",
        "lint": "find src tests bin build -name '*.php' -print0 | xargs -0 -n1 php -l",
        "analyse": "phpstan analyse --no-progress",
        "phar:build": [
            "Composer\\Config::disableProcessTimeout",
            "php -d phar.readonly=0 build/build-phar.php"
        ],
        "mutate": [
            "Composer\\Config::disableProcessTimeout",
            "XDEBUG_MODE=coverage infection --threads=max --min-msi=0 --min-covered-msi=0"
        ],
        "test": "phpunit tests",
        "test:php": "phpunit tests",
        "scan:self": "php bin/slop-scan.php scan . --github",
        "scan:php:self": "php bin/slop-scan.php scan . --github",
        "agent-loop:install": "agent-loop init install-assets --agent=all",
        "agent-loop:map": "agent-loop map build --paths=src,tests,bin",
        "agent-loop:board": "agent-loop board summary",
        "agent-loop:verify": [
            "agent-loop board verify",
            "agent-loop learn validate"
        ]
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": false
        }
    }
}
